// ─────────────────────────────────────────────────────────────
// Firestore 安全規則（留言功能 comments 集合）
//
// 這份是「參考備份」，不會自動套用。
// 要生效必須到 Firebase 主控台貼上並按「發布」：
//   Firebase Console → Firestore Database → 規則 → 全選貼上 → 發布
//
// 設計重點：
//   1. 任何人（不登入）都能「讀」留言 → allow read: if true
//   2. 只有登入 Google 的人能「新增」，且 uid 必須是自己
//   3. 留言一旦送出「不能修改」→ allow update: if false
//   4. 刪除：留言者本人 或 周周（管理員 email）
//   5. 欄位白名單 + 長度上限，防止有人塞垃圾資料把免費額度撐爆
//   6. comments 以外的任何路徑一律禁止讀寫
//
// 管理員 email 若要更動，請同步改 comments.js 的 ADMIN_EMAILS。
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 周周本人（最高權限：可刪任何留言）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'janny00jou@gmail.com';
    }

    match /comments/{id} {

      // 讀：完全公開，訪客不用登入也看得到留言
      allow read: if true;

      // 新增：必須登入，且資料格式完全符合才放行
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['slug','text','uid','name','photo','admin','createdAt'])
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 500
        // 頭像網址只允許空字串或 Google 帳號圖床，
        // 防止有人把頭像換成自己的網址來記錄每個讀者的 IP
        && (request.resource.data.photo == ''
            || request.resource.data.photo.matches('https://lh[0-9][.]googleusercontent[.]com/.*'))
        && request.resource.data.admin == isAdmin()
        && request.resource.data.createdAt == request.time;

      // 修改：一律禁止（留言送出後不能被竄改）
      allow update: if false;

      // 刪除：本人 或 周周
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── 文章點閱次數（views.js，2026-10-23 新增）──
    // views/{文章id} = { n: 累計次數, base: 從 GA 匯入的歷史基數 }
    // 顯示的數字 = base + n。
    match /views/{id} {

      // 讀：公開（統計頁與文章頁都要讀得到）
      allow read: if true;

      // 第一次：只能建成 n = 1，不能一來就塞個大數字。
      // 周周本人不受限（匯入 GA 歷史數字時要能一次寫 base）。
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['n'])
            && request.resource.data.n == 1);

      // 之後：只能「剛好 +1」，而且只准動 n 這一個欄位。
      // ⚠️ 這裡一定要用 diff().affectedKeys()，不可以寫成
      //    request.resource.data.keys().hasOnly(['n'])——
      //    前端用的是 merge 寫入，request.resource.data 是「合併後的整份文件」，
      //    已經填了 base 的文章會連 base 一起出現在 keys 裡，用 hasOnly 會整個擋掉。
      // get('n', 0) 是為了「周周先填了 base、還沒有人看過」的文章也能從 0 開始加。
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
            && request.resource.data.n is int
            && request.resource.data.n == resource.data.get('n', 0) + 1);

      // 刪除：只有周周本人（避免有人把某篇的數字洗掉重來）
      allow delete: if isAdmin();
    }

    // 其餘所有路徑：全部禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
